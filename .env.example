# Server Configuration
PORT=5001

# PostgreSQL Database Configuration
# Option 1: Connection string (Supabase, Neon, AWS RDS, Render, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academiasync
# Set to 'true' if using managed cloud databases requiring SSL (e.g., Supabase / Neon)
DATABASE_SSL=false

# Option 2: Individual connection parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=academiasync
PGUSER=postgres
PGPASSWORD=postgres
